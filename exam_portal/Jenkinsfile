pipeline {
    agent any

    stages {

        stage('Clean Workspace') {
            steps {
                echo '======================================'
                echo 'CLEANING JENKINS WORKSPACE'
                echo '======================================'

                deleteDir()
            }
        }

        stage('Checkout') {
            steps {
                echo '======================================'
                echo 'CHECKING OUT SOURCE CODE'
                echo '======================================'

                checkout scm

                echo 'Repository checkout completed.'
                echo 'Project directory: exam_portal'
            }
        }

        stage('Prepare Python CI Environment') {
    steps {
        dir('exam_portal') {
            echo '======================================'
            echo 'PREPARING PYTHON CI ENVIRONMENT'
            echo '======================================'

            powershell '''
                $ErrorActionPreference = "Stop"

                $PythonExe = "C:\\Users\\CDAC\\AppData\\Local\\Programs\\Python\\Python311\\python.exe"

                Write-Host "[INFO] Checking Python..."
                Write-Host "[INFO] Python path: $PythonExe"

                if (-not (Test-Path $PythonExe)) {
                    Write-Error "Python executable not found at $PythonExe"
                    exit 1
                }

                & $PythonExe --version

                if (-not (Test-Path ".\\.ci-venv\\Scripts\\python.exe")) {
                    Write-Host "[INFO] Creating CI virtual environment..."
                    & $PythonExe -m venv .ci-venv
                }
                else {
                    Write-Host "[INFO] CI virtual environment already exists."
                }

                $CIPython = ".\\.ci-venv\\Scripts\\python.exe"

                Write-Host "[INFO] Upgrading pip..."
                & $CIPython -m pip install --upgrade pip

                Write-Host "[INFO] Installing CI tools..."
                & $CIPython -m pip install pip-audit pytest

                Write-Host "[INFO] Verifying pip-audit..."
                & ".\\.ci-venv\\Scripts\\pip-audit.exe" --version

                Write-Host "[INFO] Verifying pytest..."
                & ".\\.ci-venv\\Scripts\\pytest.exe" --version

                Write-Host "[SUCCESS] Python CI environment ready."
            '''
        }
    }
}

        stage('Security Check') {
            steps {
                dir('exam_portal') {
                    echo '======================================'
                    echo 'RUNNING UNIVERSAL SECURITY CHECK'
                    echo '======================================'

                    powershell '''
                        $ErrorActionPreference = "Continue"

                        Write-Host ""
                        Write-Host "======================================"
                        Write-Host " DEVSECOPS SECURITY PIPELINE"
                        Write-Host " PROJECT: exam_portal"
                        Write-Host "======================================"
                        Write-Host ""

                        if (-not (Test-Path ".\\\\security-check.ps1")) {
                            Write-Host "[FAIL] security-check.ps1 not found."
                            exit 1
                        }

                        Write-Host "[INFO] Running security-check.ps1..."
                        Write-Host ""

                        .\\\\security-check.ps1

                        if ($LASTEXITCODE -ne 0) {
                            Write-Host ""
                            Write-Host "[FAIL] Security checks failed."
                            exit $LASTEXITCODE
                        }

                        Write-Host ""
                        Write-Host "[PASS] Security checks completed successfully."
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo 'SECURITY PIPELINE PASSED'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'SECURITY PIPELINE FAILED'
            echo 'DEPLOYMENT BLOCKED'
            echo '======================================'
        }
    }
}
